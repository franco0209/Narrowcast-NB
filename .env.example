# Copiar a .env (no se versiona). Valores de prueba: NO usar en una red real.
COMPOSE_PROJECT_NAME=narrowcast-nb

# Imágenes. Por defecto se construyen aquí (docker compose build).
# Para reutilizar la imagen de Lain5G (OIA) y ahorrar la compilación:
#   OPEN5GS_IMAGE=lain5g-lab/open5gs:local
OPEN5GS_IMAGE=narrowcast-nb/open5gs:local
SRSRAN_IMAGE=narrowcast-nb/srsran4g:local
WEBUI_IMAGE=narrowcast-nb/open5gs-webui:local

# WebUI solo en localhost. Cambiar si el puerto choca con otro servicio.
WEBUI_PORT=9999

# Suscriptor de prueba (srsUE virtual). Para la SIM real se cargan en la WebUI.
SUBSCRIBER_IMSI=001010000000001
SUBSCRIBER_MSISDN=
SUBSCRIBER_KEY=465B5CE8B199B49FAA5F0A2EE238A6BC
SUBSCRIBER_OPC=E8ED289DEBA952E4283B54E88E6183CA
SUBSCRIBER_AMF=8000
SUBSCRIBER_SQN=000000000000
APN_INTERNET=internet
